.git-submodule-filter-active,
#packageSearchBar.git-submodule-filter-active {
    flex-wrap: wrap;
    flex-basis: auto;
    height: auto;
    align-items: center;
    align-content: flex-start;
}

.git-submodule-filter-active > .unity-toolbar-search-field {
    min-width: 120px;
}

#git-submodule-manager-submodules-only {
    flex-shrink: 0;
}

.git-submodule-filter-hidden {
    display: none;
}
