.package-source-details {
    margin-top: 8px;
    margin-bottom: 8px;
}

.package-source-text {
    white-space: normal;
    margin-bottom: 4px;
}

.package-source-actions {
    flex-direction: row;
    flex-wrap: wrap;
}

.package-source-actions > Button {
    margin-right: 4px;
    margin-bottom: 4px;
}

.package-source-hidden {
    display: none;
}
